{
  "manifest_version": 3,
  "name": "Harem Altın Css",
  "version": "2.0",
  "description": "Harem Altın canlı piyasa takip ve analiz eklentisi.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://canlipiyasalar.haremaltin.com/*",
    "*://canlidoviz.com/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/f-logo.svg",
      "48": "assets/f-logo.svg",
      "128": "assets/f-logo.svg"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://canlipiyasalar.haremaltin.com/*"
      ],
      "js": [
        "js/harem_core.js",
        "js/fetih_analyst.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fetih.svg",
        "assets/f-logo.svg"
      ],
      "matches": [
        "*://canlipiyasalar.haremaltin.com/*"
      ]
    }
  ]
}